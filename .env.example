# Comma-separated API keys. Optional label form: sk_xxx:default,sk_yyy:ci
API_KEYS=change-me-to-a-long-random-secret

# Dev only. When true, /v1/* accepts requests without a key.
AUTH_DISABLED=false

PORT=3000
MAX_UPLOAD_BYTES=33554432
MAX_PAGES=500

# Comma-separated origins, or *
CORS_ORIGIN=*

LOG_LEVEL=info
